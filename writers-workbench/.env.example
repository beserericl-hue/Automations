# ==============================================
# The Writers Workbench — Environment Variables
# Copy this to .env and fill in the values
# ==============================================

# Supabase V2 (client-side — baked into React bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# n8n Webhook (client-side)
VITE_N8N_WEBHOOK_URL=https://n8n.agileadautomation.com/webhook/author_request_v2

# ElevenLabs (client-side)
VITE_ELEVENLABS_AGENT_ID=agent_2801kks580vnf5q80j3bd0n0x45v

# Google OAuth feature flag (client-side). Set to "true" only after the
# Supabase Google provider is configured (Client ID/Secret in dashboard
# + redirect URI in Google Cloud). Otherwise the "Continue with Google"
# button is hidden so users don't hit a broken provider.
VITE_GOOGLE_OAUTH_ENABLED=false

# Supabase (server-side only — never exposed to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n API (server-side only)
N8N_API_URL=https://n8n.agileadautomation.com
N8N_API_KEY=your-n8n-api-key

# KIE.AI Image Generation (server-side only)
KIEAI_API_KEY=your-kieai-api-key

# Server
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development

# Redis (server-side only — used by BullMQ job queues and Redis-backed sessions)
# On Railway, reference the in-project Redis service: REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}
# Leave blank for local dev if you're not exercising queue code paths.
REDIS_URL=redis://localhost:6379

# E2E Testing (optional — set for authenticated Playwright tests)
# E2E_TEST_EMAIL=test@example.com
# E2E_TEST_PASSWORD=your-test-password

# ==============================================
# Newsletter Migration sprint (server-side only)
# See writers-workbench/sprint-newsletter-migration.md
# ==============================================

# S2/S3 — Ingestion endpoints auth (n8n -> Express shared secret)
INGESTION_SECRET=change-me-ingestion-shared-secret

# S9 — Approval backend (n8n -> Express shared secret + public approval URL base)
APPROVAL_SECRET=change-me-approval-shared-secret
APPROVAL_BASE_URL=http://localhost:3001

# S5/S1 — Firecrawl for URL scraping (n8n-side, mirrored here for Workbench workflows)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# S7 — Postal self-hosted email server
EMAIL_SECRET=change-me-email-shared-secret
POSTAL_API_URL=https://postal-admin.courseworx.media/api/v1
POSTAL_API_KEY=your-postal-api-key
SENDER_EMAIL=eve@courseworx.media
SENDER_NAME=The Writers Workbench
REPLY_TO_EMAIL=support@courseworx.media
# DRY_RUN_EMAIL=true   # set to true in tests to log instead of send

# S10/S11 — Newsletter identity (which Workbench user owns ingestion/approvals/sends)
# Initially the superuser phone user_id; future sprints multi-tenant this.
NEWSLETTER_USER_ID=+14105914612
