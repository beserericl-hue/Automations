      "id": "bc2569c2-3065-4f78-a937-0c2048d0ae8e",
      "name": "fetch_reddit_or_json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "const feed = $('split_per_feed').item.json;\nconst payload = $json || {};\nconst raw = Array.isArray(payload.items) ? payload.items\n  : (Array.isArray(payload) ? payload : []);\nconst items = raw.map(it => ({\n  title: it.title || it.title_text || '(untitled)',\n  url: it.url || it.link || '',\n  source_name: it.source || feed.name || '',\n  source_url: it.url || it.link || '',\n  feed_url: feed.url,\n  body_html: it.content_html || it.content || it.description_html || it.description || '',\n  body_text: it.content_text || it.summary || '',\n  image_urls: (it.image ? [it.image] : (it.attachments || []).map(a => a.url).filter(Boolean)),\n  published_timestamp: it.date_published || it.pubDate || it.created_utc || null,\n  type: feed.url_type === 'reddit' ? 'reddit_post' : 'article',\n}));\nreturn items.map(json => ({json: {...json, _feed: feed}}));\n"
      },
      "id": "31a26be7-eab0-4916-a867-d52a6c3289f6",
      "name": "normalize_items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const it = $json;\nconst today = new Date().toISOString().slice(0,10);\nconst slug = (it.title || 'untitled').toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g,'').slice(0,80) || 'untitled';\nconst sourceTag = (it._feed.name || 'feed').toLowerCase()\n  .replace(/[^a-z0-9]+/g,'-').slice(0,40);\nreturn [{ json: { ...it, key: `${today}/${slug}.${sourceTag}` } }];\n"
      },
