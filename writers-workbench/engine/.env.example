# Copy to .env and fill in. Never commit .env.
# Engine service env (mirrors Railway service env vars).

# Auth secrets — REQUIRED. There is no compiled-in default any more (G3): an unset value is treated
# as "not configured" and every /internal and /admin request fails closed with 503, rather than
# silently accepting a placeholder that is public in this repo's history.
# Generate with: openssl rand -hex 32
SERVICE_SHARED_SECRET=
ADMIN_TOKEN=

# Supabase (DEV)
SUPABASE_URL=https://gvbvwcnmjkdpclcisqrr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# Image / scrape
KIEAI_API_KEY=
FIRECRAWL_API_KEY=

# Email + permalink delivery
POSTAL_API_KEY=
POSTAL_API_URL=
ARCHIVE_BASE_URL=https://archive.example.com

# Workbench callback (for back-calls if needed)
WORKBENCH_API_URL=https://writersworkbench-develop.up.railway.app
INGESTION_SECRET=

# Picker (decision #2: Gemini 2.5 Pro)
PICKER_MODEL=gemini-2.5-pro

# Observability
LOG_LEVEL=INFO
METRICS_PORT=9090

# A1: allow step services to substitute placeholder content when a provider key is missing.
# TRUE for the key-less local docker-compose stack. Leave UNSET on DEV/PROD so a missing or mistyped
# key fails loudly instead of persisting and emailing a fixture to the user as real work.
ALLOW_FIXTURE_FALLBACK=true

